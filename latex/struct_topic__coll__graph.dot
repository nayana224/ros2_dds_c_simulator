digraph "Topic"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="Topic",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="A topic registered in the simulator."];
  Node2 -> Node1 [id="edge8_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">publishers</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node2 [id="Node000002",label="Publisher",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_publisher.html",tooltip="A publisher entry attached to a topic."];
  Node2 -> Node2 [id="edge9_Node000002_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">next</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node3 -> Node1 [id="edge10_Node000001_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">subscribers</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node3 [id="Node000003",label="Subscriber",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_subscriber.html",tooltip="A subscriber entry attached to a topic."];
  Node3 -> Node3 [id="edge11_Node000003_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">next</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node4 -> Node1 [id="edge12_Node000001_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">message_head</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">message_tail</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node4 [id="Node000004",label="Message",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$struct_message.html",tooltip="A message stored in a topic queue."];
  Node4 -> Node4 [id="edge13_Node000004_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">next</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node1 -> Node1 [id="edge14_Node000001_Node000001",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">next</TD></TR>
</TABLE>> ,fontcolor="grey" ];
}
